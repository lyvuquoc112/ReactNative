# =============================================================================
# .gitignore for React Native & Expo (Android / iOS / Web) Projects
# =============================================================================

# Dependencies
node_modules/
.npm/
.pnpm-store/
.pnp
.pnp.*

# Yarn Berry (v2+)
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/sdks
!**/.yarn/versions

# Expo & Metro Bundler
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
.metro-health-check*
.metro-cache/

# Android, Gradle & Kotlin
.kotlin/
.gradle/
local.properties
*.apk
*.aab
*.ap_
*.dex
*.jks
*.keystore

# iOS, Xcode & CocoaPods
Pods/
DerivedData/
build/
*.ipa
*.dSYM.zip
*.dSYM
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.p8
*.p12
*.key
*.mobileprovision

# Environment Variables & Certificates
.env
.env.*
*.env
!.env.example
!.env.sample
!.env.template
*.pem
*.orig.*

# TypeScript, Testing & Logs
*.tsbuildinfo
.eslintcache
coverage/
logs/
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.log*

# IDEs, Editors & Local AI Configs
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
!**/.vscode/extensions.json
!**/.vscode/*.code-snippets
.idea/
*.iml
*.sw?
**/.claude/settings.local.json
CLAUDE.local.md

# Operating System
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
*~
